{
  "name": "dojo-planner",
  "version": "1.58.6",
  "author": "RCCN LLC",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build --webpack",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server --run 'npm run db:migrate'",
    "db:generate": "echo '\\n  db:generate is DISABLED.\\n\\n  There is no migrations/meta/0000_snapshot.json, so drizzle-kit would\\n  regenerate the ENTIRE schema and clobber the hand-authored baseline.\\n\\n  To change the schema: edit src/models/Schema.ts AND add a new numbered\\n  migrations/000N_<name>.sql by hand, then add its entry to\\n  migrations/meta/_journal.json. See CLAUDE.md.\\n' && exit 1",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:tenants": "tsx src/scripts/migrateTenants.ts",
    "db:register-tenants": "tsx src/scripts/registerTenants.ts",
    "db:check-tenants": "tsx src/scripts/checkTenantReadiness.ts",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build",
    "stripe:listen": "stripe listen --forward-to localhost:3000/webhook/billing",
    "stripe:setup-price": "dotenv -c -- tsx ./scripts/createStripePrice.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.6",
    "@clerk/localizations": "^3.37.8",
    "@clerk/nextjs": "^6.39.6",
    "@clerk/themes": "^2.4.57",
    "@logtape/logtape": "^1.3.11",
    "@orpc/client": "^1.14.13",
    "@orpc/server": "^1.14.13",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.68.0",
    "@swc/helpers": "0.5.23",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-is": "^19.2.8",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@chromatic-com/playwright": "^0.14.11",
    "@clerk/testing": "^1.14.9",
    "@clerk/types": "^4.101.10",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt-cli": "^20.5.3",
    "@commitlint/types": "^20.3.1",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@faker-js/faker": "^10.5.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.2.12",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@spotlightjs/spotlight": "4.11.8",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^6.9.7",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.5",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "knip": "^5.88.1",
    "lefthook": "^2.1.10",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.8",
    "storybook": "^10.1.10",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16",
    "vitest-browser-react": "^2.2.0"
  },
  "overrides": {
    "eslint-plugin-react-refresh": "^0.4.26"
  }
}
